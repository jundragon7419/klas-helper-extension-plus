{
  "name": "klas-helper-extension-plus",
  "description": "KLAS 화면에서 마감을 한곳에 모아 보는 브라우저 확장",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:build": "node scripts/ci/check-build-output.js",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "test:e2e": "playwright test",
    "fixtures:snippet": "node scripts/fixtures/build-snippet.ts api",
    "fixtures:dom-snippet": "node scripts/fixtures/build-snippet.ts dom",
    "ai:metrics": "node scripts/ai/metrics.js",
    "tokens:preview": "vite --config scripts/tokens-preview/vite.config.ts",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "linkedom": "^0.18.15",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "preact": "^11.2.0"
  }
}
